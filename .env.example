# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL="postgresql://username:password@host:port/database_name"

# Application Domain Configuration
DOMAIN=sekondly.app
APP_URL=https://sekondly.app
API_URL=https://api.sekondly.app

SESSION_SECRET=something-random-for-cookies

# CORS Origins for production
CORS_ORIGIN=https://sekondly.app,https://www.sekondly.app,https://api.sekondly.app,http://localhost:3000,http://localhost:8081

# Port Configuration
PORT=5001

# Development Environment
NODE_ENV=development

# Email Configuration for Account Deletion Requests
# For Gmail: Use an app password instead of your regular password
# For other providers: Configure accordingly
EMAIL_USER=noreply@sekondly.app
EMAIL_PASS=your-app-password-here
